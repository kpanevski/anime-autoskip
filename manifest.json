{
  "manifest_version": 3,
  "name": "Anime Auto-Skip",
  "version": "1.2.1",
  "description": "Skips intros, credits and recaps on Crunchyroll and plays the next episode. Unofficial, not affiliated with Crunchyroll.",
  "permissions": ["storage"],
  "host_permissions": ["https://graphql.anilist.co/*", "https://api.aniskip.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Anime Auto-Skip",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.crunchyroll.com/*", "https://static.crunchyroll.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
