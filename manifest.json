{
  "manifest_version": 3,
  "name": "Crunchyroll Auto-Skip",
  "version": "1.1.0",
  "description": "Automatically skips Crunchyroll intros, credits and recaps, with AniSkip timings when there's no skip button.",
  "permissions": ["storage"],
  "host_permissions": ["https://graphql.anilist.co/*", "https://api.aniskip.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Crunchyroll Auto-Skip",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.crunchyroll.com/*", "https://static.crunchyroll.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
